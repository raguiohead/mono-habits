# Firebase Client Configuration (Vite)
# Obtenha estas credenciais no Firebase Console (Configurações do Projeto > Geral > Seus apps > Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ID opcional da aplicação para namespace de dados no Firestore
VITE_APP_ID=mono-habit-tracker
