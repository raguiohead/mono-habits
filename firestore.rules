rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Regra estrita de segurança do MONO // HABITS:
    // Cada usuário só pode ler, criar, atualizar ou excluir seus próprios hábitos e registros de check-in.
    match /artifacts/{appId}/users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Bloqueia qualquer outro acesso não autorizado por padrão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
